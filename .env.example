# Copie este arquivo para .env e preencha com os dados públicos do seu projeto Supabase.
# Nunca coloque SUPABASE_SERVICE_ROLE_KEY ou qualquer chave secreta em variáveis VITE_.
SUPABASE_PROJECT_ID=seu_project_id
SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable
SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PROJECT_ID=seu_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
